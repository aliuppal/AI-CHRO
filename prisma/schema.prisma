// AI CHRO — Prisma schema (Prisma 7, Neon Postgres)
// Connection URLs live in prisma.config.ts (migrations, direct) and src/lib/db.ts (runtime, pooled).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  NOTICE_PERIOD
  TERMINATED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  FILLED
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ReviewStatus {
  DRAFT
  AI_DRAFTED
  IN_REVIEW
  SUBMITTED
  ACKNOWLEDGED
}

enum PolicyStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ComplianceStatus {
  NOT_CHECKED
  PASSED
  WARNINGS
  FAILED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AlertType {
  BURNOUT
  FLIGHT_RISK
  ENGAGEMENT_DROP
  COMPLIANCE
  HIRING
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum ChatRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum AiTarget {
  CHAT_MESSAGE
  PERFORMANCE_REVIEW
  POLICY
  ONBOARDING_PLAN
  PULSE_SURVEY
  INTERVIEW_QUESTIONS
  RISK_ALERT
}

enum Rating {
  UP
  DOWN
}

// ─────────────────────────── Tenancy & auth ───────────────────────────

/// One customer company. Every HR record is scoped to an organization.
model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  industry      String?
  headcountBand String? /// e.g. "50-200"; used to size policies
  country       String   @default("US") /// ISO 3166-1 alpha-2; drives compliance rules
  region        String? /// state / province, e.g. "CA"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users           User[]
  departments     Department[]
  employees       Employee[]
  jobPostings     JobPosting[]
  candidates      Candidate[]
  applications    Application[]
  reviews         PerformanceReview[]
  policies        Policy[]
  conversations   ChatConversation[]
  pulseSurveys    PulseSurvey[]
  riskAlerts      RiskAlert[]
  onboardingPlans OnboardingPlan[]
  aiFeedback      AiFeedback[]
  auditLogs       AuditLog[]
}

/// A person who can sign in. Linked 1:1 to an Employee record when they work at the org.
model User {
  id             String   @id @default(cuid())
  externalAuthId String?  @unique /// Clerk user id or Auth.js subject
  email          String   @unique
  name           String?
  imageUrl       String?
  role           Role     @default(EMPLOYEE)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee         Employee?
  conversations    ChatConversation[]
  jobsCreated      JobPosting[]       @relation("JobCreatedBy")
  policiesAuthored Policy[]           @relation("PolicyAuthor")
  surveysCreated   PulseSurvey[]      @relation("SurveyCreatedBy")
  aiFeedback       AiFeedback[]
  auditLogs        AuditLog[]

  @@index([organizationId])
}

// ───────────────────────────── People ─────────────────────────────

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees       Employee[]
  jobPostings     JobPosting[]
  pulseSurveys    PulseSurvey[]
  surveyResponses SurveyResponse[]
  riskAlerts      RiskAlert[]

  @@unique([organizationId, name])
}

model Employee {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?          @unique
  employeeNumber String?
  firstName      String
  lastName       String
  email          String
  jobTitle       String
  level          String? /// e.g. "IC3", "Senior", "Director"
  departmentId   String?
  managerId      String?
  employmentType EmploymentType   @default(FULL_TIME)
  status         EmploymentStatus @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime?
  country        String? /// work location, for compliance checks
  region         String?

  /// Optional, self-reported. Used only in aggregate for diversity metrics; restrict to ADMIN.
  genderIdentity String?

  skills      String[]
  careerGoals String?

  /// Model-scored retention risk, 0–100. Never shown to the employee themselves.
  turnoverRiskScore Int?
  riskLevel         RiskLevel?
  riskUpdatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  department     Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager        Employee?           @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports  Employee[]          @relation("Reports")
  reviews        PerformanceReview[] @relation("ReviewSubject")
  reviewsWritten PerformanceReview[] @relation("ReviewAuthor")
  jobsManaged    JobPosting[]        @relation("HiringManager")
  onboardingPlan OnboardingPlan?
  riskAlerts     RiskAlert[]
  hiredFrom      Application?        @relation("HiredAs")

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([departmentId])
  @@index([managerId])
}

// ───────────────────────── Talent acquisition ─────────────────────────

model JobPosting {
  id              String         @id @default(cuid())
  organizationId  String
  title           String
  departmentId    String?
  hiringManagerId String?
  createdById     String?
  description     String
  requirements    String[]
  location        String?
  remote          Boolean        @default(false)
  employmentType  EmploymentType @default(FULL_TIME)
  salaryMin       Int?
  salaryMax       Int?
  currency        String         @default("USD")
  status          JobStatus      @default(DRAFT)
  openedAt        DateTime? /// time-to-fill = filledAt - openedAt
  filledAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  hiringManager Employee?     @relation("HiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  applications  Application[]

  @@index([organizationId, status])
}

model Candidate {
  id             String  @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String
  phone          String?
  linkedinUrl    String?
  source         String? /// "referral", "linkedin", "careers page"…
  resumeUrl      String?
  resumeText     String? /// extracted plain text, input to the AI parser
  parsedProfile  Json? /// { skills[], experience[], education[], yearsExperience }

  /// Candidate data-retention consent (GDPR / CCPA).
  consentGivenAt     DateTime?
  dataRetentionUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([organizationId, email])
}

/// A candidate's application to one job. This is the card on the Kanban board.
model Application {
  id                 String           @id @default(cuid())
  organizationId     String
  candidateId        String
  jobPostingId       String
  stage              ApplicationStage @default(APPLIED)
  boardPosition      Float            @default(0) /// fractional index for drag-and-drop order within a stage
  fitScore           Int? /// AI match score, 0–100
  fitSummary         String? /// AI explanation of strengths and gaps
  interviewQuestions Json? /// AI-generated, tailored to resume + JD
  rejectionReason    String?
  hiredEmployeeId    String?          @unique
  appliedAt          DateTime         @default(now())
  stageChangedAt     DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting    JobPosting   @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  hiredEmployee Employee?    @relation("HiredAs", fields: [hiredEmployeeId], references: [id], onDelete: SetNull)

  @@unique([candidateId, jobPostingId])
  @@index([jobPostingId, stage, boardPosition])
  @@index([organizationId, stage])
}

model OnboardingPlan {
  id             String           @id @default(cuid())
  organizationId String
  employeeId     String           @unique
  role           String
  plan           Json /// { day30: Milestone[], day60: Milestone[], day90: Milestone[] }
  status         OnboardingStatus @default(NOT_STARTED)
  aiGenerated    Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ───────────────────────── Performance & growth ─────────────────────────

model PerformanceReview {
  id             String       @id @default(cuid())
  organizationId String
  employeeId     String
  reviewerId     String?
  cycleName      String /// e.g. "H1 2026"
  periodStart    DateTime
  periodEnd      DateTime
  status         ReviewStatus @default(DRAFT)

  managerNotes String? /// manager's raw bullet points (AI input)
  peerFeedback Json? /// [{ fromRole, text }] — anonymised before storage
  aiDraft      String? /// AI-drafted summary
  biasFlags    Json? /// [{ phrase, reason, suggestion }] from the language check
  finalSummary String? /// what the manager actually submits
  rating       Int? /// 1–5

  /// Skill-gap analysis and suggested L&D courses.
  skillGaps Json? /// [{ skill, current, target, courses[] }]

  submittedAt    DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("ReviewSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer     Employee?    @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([employeeId, cycleName])
  @@index([organizationId, status])
  @@index([reviewerId])
}

// ───────────────────────── Engagement & retention ─────────────────────────

model PulseSurvey {
  id             String       @id @default(cuid())
  organizationId String
  departmentId   String? /// null = whole company
  createdById    String?
  title          String
  questions      Json /// [{ id, type: "scale"|"text"|"enps", prompt }]
  status         SurveyStatus @default(DRAFT)
  aiGenerated    Boolean      @default(true)
  opensAt        DateTime?
  closesAt       DateTime?
  createdAt      DateTime     @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("SurveyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  responses    SurveyResponse[]

  @@index([organizationId, status])
}

/// Anonymous by design: no employee or user link. Only show department-level results
/// when a group has at least 5 responses, so individuals can't be re-identified.
model SurveyResponse {
  id             String   @id @default(cuid())
  surveyId       String
  departmentId   String?
  answers        Json
  enpsScore      Int? /// 0–10
  freeText       String?
  sentimentScore Float? /// -1.0 … 1.0
  sentimentLabel String? /// "positive" | "neutral" | "negative"
  themes         String[] /// AI-extracted, e.g. ["workload", "career growth"]
  createdAt      DateTime @default(now())

  survey     PulseSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([surveyId])
  @@index([departmentId])
}

/// Flags that power the "AI Daily Briefing" and manager interventions.
model RiskAlert {
  id               String      @id @default(cuid())
  organizationId   String
  employeeId       String? /// set for individual signals (tenure, review data…)
  departmentId     String? /// set for aggregate signals (survey sentiment drop…)
  type             AlertType
  level            RiskLevel
  title            String
  reason           String
  suggestedActions Json? /// [{ action, owner, dueInDays }]
  status           AlertStatus @default(OPEN)
  resolvedAt       DateTime?
  createdAt        DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, level])
}

// ───────────────────────── Operations & compliance ─────────────────────────

model Policy {
  id               String           @id @default(cuid())
  organizationId   String
  authorId         String?
  title            String
  slug             String
  category         String /// "remote-work", "pto", "code-of-conduct"…
  country          String? /// jurisdiction the policy was written for
  region           String?
  version          Int              @default(1)
  content          String /// Markdown
  status           PolicyStatus     @default(DRAFT)
  complianceStatus ComplianceStatus @default(NOT_CHECKED)
  complianceReport Json? /// [{ severity, clause, issue, suggestion, reference }]
  aiGenerated      Boolean          @default(true)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation("PolicyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, slug, version])
  @@index([organizationId, status])
}

// ───────────────────────── Ask CHRO (chat) ─────────────────────────

model ChatConversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String /// plain text, for search and history
  parts          Json? /// AI SDK UIMessage parts (tool calls, sources…)
  model          String? /// OpenRouter model id that produced it
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ───────────────────────── AI feedback & audit ─────────────────────────

/// Thumbs up/down on any AI-generated text.
model AiFeedback {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  targetType     AiTarget
  targetId       String
  rating         Rating
  comment        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

/// Who viewed or changed sensitive HR data, and when.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String /// "review.submit", "employee.view_risk"…
  entity         String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}
