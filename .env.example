# ── Neon Postgres ──────────────────────────────────────────────
# Neon console → your project → Connect → copy both strings.
# Pooled (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct (same host WITHOUT "-pooler") — used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── OpenRouter ─────────────────────────────────────────────────
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# Any model id ending in ":free" — https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b:free"
# Fallback tried automatically if the primary free model is rate-limited.
OPENROUTER_FALLBACK_MODEL="google/gemma-4-31b-it:free"

# ── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
